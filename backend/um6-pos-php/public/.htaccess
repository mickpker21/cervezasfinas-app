RewriteEngine On

# Servir archivos y directorios existentes directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Permitir acceso directo a uploads
RewriteRule ^uploads/ - [L]

# Redirigir /health y /api/* al front controller
RewriteRule ^(health|api/.*)$ index.php [QSA,L]

